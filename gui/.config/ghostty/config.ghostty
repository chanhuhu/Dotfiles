window-decoration = false 
# Colors
foreground = #d5c4a1
background = #1d2021
cursor-color = #d5c4a1
cursor-text = #1d2021

# Normal Colors
palette = 0=#1d2021
palette = 1=#fb4934
palette = 2=#b8bb26
palette = 3=#fabd2f
palette = 4=#83a598
palette = 5=#d3869b
palette = 6=#8ec07c
palette = 7=#d5c4a1

# Bright Colors
palette = 8=#665c54
palette = 9=#fb4934
palette = 10=#b8bb26
palette = 11=#fabd2f
palette = 12=#83a598
palette = 13=#d3869b
palette = 14=#8ec07c
palette = 15=#fbf1c7

# Indexed Colors
palette = 16=#fe8019
palette = 17=#d65d0e
palette = 18=#3c3836
palette = 19=#504945
palette = 20=#bdae93
palette = 21=#ebdbb2

# Font
font-family = "Noto Sans Mono"
font-size = 13

# Thai fallback font & features
font-codepoint-map = U+0E00-U+0E7F=Noto Sans Thai Looped

# Cursor
shell-integration-features = no-cursor
cursor-style = block
cursor-style-blink = false

# Window & Audio
confirm-close-surface = false
bell-features = no-audio,no-system
